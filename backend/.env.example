# Server Configuration
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
NODE_ENV=development

# Rule34 API Credentials
RULE34_API_KEY=your_api_key_here
RULE34_API_USER=your_username_here

# CORS & Security
FRONTEND_ORIGIN=http://localhost:5173

# Sync Encryption
SYNC_ENCRYPTION_SECRET=your_secret_key_here_at_least_32_characters

# Valkey/Redis Configuration
VALKEY_ENABLED=true
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# Optional
KUROSEARCH_CANONICAL_URL=https://your-domain.com

# GitHub Repository (for version fetching)
# Format: owner/repo (e.g., username/ks-websocket)
GITHUB_REPO=owner/repo
