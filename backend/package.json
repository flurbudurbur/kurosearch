{
	"name": "@flur34/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Fastify backend server for Flur34 with WebSocket support",
	"author": {
		"name": "flurbudurbur"
	},
	"contributors": [
		"kurozenzen"
	],
	"license": "proprietary",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
