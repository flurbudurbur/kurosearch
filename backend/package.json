		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.0",
		"@types/pako": "^2.0.4",
		"@types/ws": "^8.5.13",
		"@vitest/coverage-v8": "3.2.4",
		"pino-pretty": "^13.1.2",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
