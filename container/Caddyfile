{
	admin off

	log {
		output stderr
		format filter {
			# Preserves first 8 bits from IPv4 and 32 bits from IPv6
			request>remote_ip ip_mask 8 32
			request>client_ip ip_mask 8 32

			# Remove identificable information
			request>remote_port delete
			request>headers delete
			request>uri query {
				delete url
				delete h
				delete q
			}
		}
	}

	servers {
		client_ip_headers X-Forwarded-For X-Real-IP

		# Allow the following IP to passthrough the "X-Forwarded-*" headers to KuroSearch
		# https://caddyserver.com/docs/caddyfile/options#trusted-proxies
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

{$KUROSEARCH_HOST} {

    tls {$KUROSEARCH_TLS}

    # Global headers for all routes
    header {
        # disable browser functionality
        Permissions-Policy "accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()"
        Referrer-Policy "same-origin"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # WebSocket endpoint - proxy to api with upgrade support
    @websocket {
        path /ws
    }
    reverse_proxy @websocket http://backend:3001 {
        # WebSocket-specific headers
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
    }

    # API endpoints - proxy to api
    @api {
        path /api/*
    }
    reverse_proxy @api http://backend:3001

    # Static files - serve from frontend build
    root * /srv
    encode zstd gzip

    # SEO: Allow homepage indexing with controlled behavior
    @root {
        path /
    }
    header @root {
        X-Robots-Tag "nofollow, noarchive, nosnippet, noimageindex"
    }

    # SEO: Block indexing for all other routes (content, API, user pages)
    @other {
        not path /
        not path /api/*
        not path /ws
    }
    header @other {
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    }

    # Cache headers for static assets
    @static {
        path_regexp static \.(js|css|woff2?|ttf|png|jpg|jpeg|svg|gif|ico|mp4|webm)$
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # SPA fallback - serve index.html for client-side routing
    try_files {path} /index.html
    file_server
}