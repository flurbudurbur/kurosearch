{
	"name": "flur34",
	"version": "2.0.0",
	"private": true,
	"license": "proprietary",
	"author": {
		"name": "flurbudurbur"
	},
	"contributors": [
		"kurozenzen"
	],
	"maintainers": [
		"flurbudurbur"
	],
	"homepage": "https://flur34.com",
	"bugs": "https://github.com/flur34/flur34/issues",
	"repository": "https://github.com/flur34/flur34",
	"readme": "README.md",
	"scripts": {
		"web:dev": "pnpm --filter @flur34/web dev",
		"web:build": "pnpm --filter @flur34/web build",
		"web:build:analyze": "pnpm --filter @flur34/web build:analyze",
		"web:preview": "pnpm --filter @flur34/web preview",
		"web:check": "pnpm --filter @flur34/web check",
		"web:lint": "pnpm --filter @flur34/web lint",
		"web:test": "pnpm --filter @flur34/web test",
		"web:test:integration": "pnpm --filter @flur34/web test:integration",
		"web:test:e2e": "pnpm --filter @flur34/web test:e2e",
		"web:test:all": "pnpm --filter @flur34/web test:all",
		"api:dev": "pnpm --filter @flur34/api dev",
		"api:build": "pnpm --filter @flur34/api build",
		"api:start": "pnpm --filter @flur34/api start",
		"api:check": "pnpm --filter @flur34/api check",
		"api:lint": "pnpm --filter @flur34/api lint",
		"api:test": "pnpm --filter @flur34/api test",
		"dev": "pnpm web:dev",
		"dev:all": "concurrently --kill-others -n WEB,API -c cyan,magenta \"pnpm web:dev\" \"pnpm api:dev\"",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"lint:fix": "prettier . --write .",
		"test": "pnpm -r test",
		"postinstall": "pnpm --filter @flur34/web exec svelte-kit sync",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@types/pako": "^2.0.4",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"@vitest/coverage-v8": "4.0.14",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"prettier": "^3.7.3",
		"prettier-plugin-svelte": "^3.4.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.14"
	},
	"type": "module",
	"packageManager": "pnpm@10.24.0"
}
