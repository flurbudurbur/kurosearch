# These default values work out of the box.
# Only change these if you know what you're doing!

# ===========================
# Frontend Configuration
# ===========================

# Backend API URL for frontend to connect to
# Format: <protocol>://<domain>[:port]
#
# Local Development (without Caddy):
#   Set to http://localhost:3001 to connect directly to Fastify api
#   Start api with: pnpm dev:api
#   Start frontend with: pnpm dev
PUBLIC_BACKEND_URL=http://localhost:3001
#
# Production (with Caddy):
#   Set to your domain (e.g., https://yourdomain.com)
#   Caddy will proxy /api/* and /ws to api:3001 internally
#   Build frontend with: pnpm build
#   Deploy with: docker compose up -d
# PUBLIC_BACKEND_URL=https://yourdomain.com

# Domain/hostname for the Caddy reverse proxy server matcher
# This should be just the domain name, without protocol or trailing slash
# example: example.com
KUROSEARCH_HOST=localhost

# TLS configuration for Caddy
# Use "internal" for self-signed certificates, or provide your email for Let's Encrypt
KUROSEARCH_TLS=internal

# Canonical URL for SEO (baked into static build for robots.txt/sitemap.xml)
# OPTIONAL: If not set, falls back to https://flur34.com
# This should be set at build time (automatically set in GitHub Actions)
# format: <protocol>://<domain> (no trailing slash)
# example: https://example.com
#PUBLIC_CANONICAL_URL=

# GitHub commit SHA (automatically set during GitHub Actions build)
# OPTIONAL: If not set, version info will not display GitHub SHA
#PUBLIC_GITHUB_SHA=

# ===========================
# Backend Configuration
# ===========================

# Get these on https://rule34.xxx > login > options > check "generate new api key" > save
RULE34_API_KEY=
RULE34_API_USER=

# CSRF protection: put your domain here
# format: <protocol>://<domain>[:port]
# example: https://example.com:8080
FRONTEND_ORIGIN=https://localhost

# Canonical URL for SEO (sitemap, meta tags, OpenGraph)
# OPTIONAL: If not set, falls back to FRONTEND_ORIGIN, then request origin, then https://flur34.com
# This is the public-facing URL where your instance is hosted
# format: <protocol>://<domain> (no trailing slash)
# example: https://example.com
#KUROSEARCH_CANONICAL_URL=

# Sync encryption secret: use a strong random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
SYNC_ENCRYPTION_SECRET=

# If you choose to leave these as-is, defaults
# will be used pointing to flur34's resources
#PUBLIC_APP_NAME=
#PUBLIC_SPONSOR_URL=
#PUBLIC_DISCORD_URL=
#PUBLIC_SOURCE_CODE_URL=

# Backend server settings
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Valkey (Redis-compatible) configuration for /api/sync
# Set to "false" to disable Valkey and return 503 for sync endpoints
VALKEY_ENABLED=false
# Use "valkey" for Docker Compose, "localhost" for local development
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# GitHub Repository (for version fetching)
# Format: owner/repo (e.g., username/ks-websocket)
#GITHUB_REPO=owner/repo